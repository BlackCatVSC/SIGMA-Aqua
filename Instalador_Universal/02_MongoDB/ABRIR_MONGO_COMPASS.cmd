@echo off
setlocal
cd /d "%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; try { $r=Get-NetTCPConnection -LocalPort 27018 -State Listen -ErrorAction SilentlyContinue; if(-not $r){throw 'MongoDB no esta disponible. Ejecuta INICIAR_SIGMA_AQUA.cmd primero.'}; $out=& docker exec sigma_aqua_v2-mongo-1 mongosh sigma_aqua --quiet --eval 'JSON.stringify({ping:db.adminCommand({ping:1}).ok,reportes:db.reportes_jaula.countDocuments(),unique:db.reportes_jaula.getIndexes().some(i=>i.key.codigo_reporte===1 && i.unique===true)})'; if($LASTEXITCODE -ne 0){throw 'No se pudo consultar MongoDB'}; $v=($out -join '') | ConvertFrom-Json; if($v.ping -ne 1){throw 'MongoDB no responde'}; Write-Host ('MongoDB conectado. Reportes: '+$v.reportes+'; indice unico: '+$v.unique) -ForegroundColor Green; if($v.reportes -ne 7 -or -not $v.unique){Write-Warning 'El estado difiere de los datos iniciales esperados.'}; $paths=@((Join-Path $env:LOCALAPPDATA 'MongoDBCompass\MongoDBCompass.exe'),(Join-Path $env:LOCALAPPDATA 'Programs\MongoDB Compass\MongoDBCompass.exe'),(Join-Path $env:ProgramFiles 'MongoDB Compass\MongoDBCompass.exe')); $exe=$paths | Where-Object {Test-Path $_} | Select-Object -First 1; if(-not $exe){$cmd=Get-Command MongoDBCompass.exe -ErrorAction SilentlyContinue; if($cmd){$exe=$cmd.Source}}; if(-not $exe){$app=Get-StartApps | Where-Object {$_.Name -like '*MongoDB Compass*'} | Select-Object -First 1; if($app){Start-Process explorer.exe ('shell:AppsFolder\'+$app.AppID); Write-Host 'Conecta manualmente usando mongodb://127.0.0.1:27018/sigma_aqua'; exit 0}; throw 'No se encontro MongoDB Compass instalado.'}; Start-Process -FilePath $exe -ArgumentList 'mongodb://127.0.0.1:27018/sigma_aqua'; Write-Host 'Compass abierto. Selecciona sigma_aqua > reportes_jaula.' } catch {Write-Host $_.Exception.Message -ForegroundColor Red; exit 1}"
set "RC=%ERRORLEVEL%"
pause
exit /b %RC%
